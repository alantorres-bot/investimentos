# Copie este arquivo para .streamlit/secrets.toml e preencha os valores.
# O secrets.toml de verdade NUNCA vai para o GitHub (está no .gitignore).

# Login do app — gere o hash com: .venv\Scripts\python.exe gerar_senha.py
APP_USUARIO = "alan"
APP_SENHA_HASH = "pbkdf2_sha256$240000$...$..."

# Banco na nuvem (Supabase > Project Settings > Database > Connection string > URI).
# Deixe comentado para usar o rendimentos.db local.
# DATABASE_URL = "postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
